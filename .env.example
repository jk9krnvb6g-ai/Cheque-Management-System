# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =====================================================================
# Server & Port Configuration (การตั้งค่าพอร์ตและเซิร์ฟเวอร์)
# =====================================================================
# พอร์ต Backend API สำหรับระบบพิมพ์เช็ค (พอร์ต 3002)
PORT=3002

# เส้นทาง URL ย่อย (Base Path) สำหรับรันเป็น /Cash_Cheque/
VITE_BASE_PATH="/Cash_Cheque/"

# =====================================================================
# Central Database Configuration (การตั้งค่าเชื่อมต่อฐานข้อมูลเครื่อง 10.1.0.201)
# =====================================================================
# IP ของเครื่องแม่ข่ายฐานข้อมูล
DB_HOST=10.1.0.201

# พอร์ต MySQL (ค่าเริ่มต้นคือ 3306)
DB_PORT=3306

# ชื่อผู้ใช้ฐานข้อมูล (ค่าเริ่มต้น XAMPP คือ root)
DB_USER=root

# รหัสผ่านฐานข้อมูล (ค่าเริ่มต้น XAMPP คือไม่มีรหัสผ่าน ให้เว้นว่างไว้)
DB_PASSWORD=

# ชื่อฐานข้อมูลที่สร้างจากไฟล์ cheque_system.sql
DB_NAME=cheque_system

